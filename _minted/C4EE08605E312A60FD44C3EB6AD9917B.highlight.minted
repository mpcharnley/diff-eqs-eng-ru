\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{function}\PYG{+w}{ }\PYG{n+nf}{quiver2D244}\PYG{p}{(}f,g, x\PYGZus{}min, x\PYGZus{}max, y\PYGZus{}min, y\PYGZus{}max, col\PYG{p}{)}
\PYG{c}{\PYGZpc{} quiver2D244.m}
\PYG{c}{\PYGZpc{} Author: Matt Charnley}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{} This function draws a quiver plot for the ODE dx/dt = f(x,y), dy/dt = g(x,y) for}
\PYG{c}{\PYGZpc{} x\PYGZus{}min \PYGZlt{}= x \PYGZlt{}= x\PYGZus{}max and y\PYGZus{}min \PYGZlt{}= y \PYGZlt{}= y\PYGZus{}max. The functions f and g should be}
\PYG{c}{\PYGZpc{} passed in as an anonymous functions, f = @(x,y) ...}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{} The function draws this quiver plot in color col in the current figure}
\PYG{c}{\PYGZpc{} and generates a normalized version (all vectors are the same length)}
\PYG{c}{\PYGZpc{} as the next figure, so that it can be accessed outside of this function.}
\PYG{c}{\PYGZpc{} For this second figure, the magnitude of the arrows does not mean}
\PYG{c}{\PYGZpc{} anything, but it is easier to see the direction of them.}
\PYG{c}{\PYGZpc{}}
\PYG{c}{\PYGZpc{} It will start with}
\PYG{c}{\PYGZpc{} hold on; and end with hold off;, so the figure needs to be cleared in the}
\PYG{c}{\PYGZpc{} main file if needed.}
\end{MintedVerbatim}
